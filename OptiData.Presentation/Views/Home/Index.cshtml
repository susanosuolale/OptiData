@{
    ViewData["Title"] = "OptiData - Bundle Optimizer";
}
@model OptiData.Presentation.Models.OptimizationResultViewModel

<div class="container mt-5">
    <!-- Huge Centered Hero Section (Flourish Style) -->
    <div class="text-center py-5 mb-5">
        <h1 class="display-2 fw-bold" style="color: var(--primary-accent); letter-spacing: -1px; margin-bottom: 20px;">OptiData</h1>
        <h2 class="display-6 mb-4" style="color: var(--text-muted); font-weight: 500;">Never guess your data usage again.</h2>
        
        <div class="mx-auto mt-5" style="max-width: 900px;">
            <h3 style="color: var(--primary-accent); font-size: 28px; font-weight: bold; margin-bottom: 15px;">Intelligent Bundle Optimization</h3>
            <p style="color: var(--text-main); font-size: 18px; line-height: 1.8; opacity: 0.9;">
                Have you ever bought a 3GB data plan for the weekend, only to run out on Saturday night? Or bought a 30GB plan for the month, and watched 4GB expire? We all experience this frustrating guessing game. OptiData predicts precisely how much data you actually need and recommends the absolute cheapest mathematical combination of bundles.
            </p>
        </div>
    </div>

    <!-- Main Optimization Form (Centered) -->
    <div class="row justify-content-center mb-5">
        <div class="col-md-8">
            <div class="glass-container p-5 text-center">
                <h3 style="color: var(--primary-accent); font-size: 26px; margin-bottom: 30px;">Start Optimizing</h3>
                <form id="optimizeForm">
                    <div class="input-group" style="margin-bottom: 25px; text-align: left; display: block;">
                        <label style="display: block; color: var(--text-main); font-weight: 600; margin-bottom: 10px;">How long do you need data for?</label>
                        <div class="d-flex gap-2">
                            <input type="number" id="durationInput" name="duration" value="1" min="1" required class="form-control w-50" style="padding: 12px;" />
                            <select id="timeUnitInput" name="timeUnit" class="form-select w-50" required style="padding: 12px;">
                                <option value="Hours">Hours</option>
                                <option value="Days" selected>Days</option>
                                <option value="Months">Months</option>
                                <option value="Years">Years</option>
                            </select>
                        </div>
                    </div>
                    <div class="input-group" style="margin-bottom: 30px; text-align: left; display: block;">
                        <label style="display: block; color: var(--text-main); font-weight: 600; margin-bottom: 10px;">Select Telecom Provider</label>
                        <select id="providerInput" name="provider" class="form-select" required style="padding: 12px;">
                            <option value="" disabled selected>Select Provider</option>
                            <option value="MTN">MTN</option>
                            <option value="Airtel">Airtel</option>
                            <option value="GLO">GLO</option>
                            <option value="NineMobile">9Mobile</option>
                        </select>
                        <div id="selectedProviderDisplay" style="margin-top: 15px; display: none; padding: 12px 18px; border-radius: 12px; background: rgba(255, 42, 117, 0.05); border: 1px solid var(--secondary-accent); font-weight: 600; color: var(--text-main); align-items: center; gap: 10px; transition: all 0.3s ease;">
                            <span style="font-size: 20px;">📡</span> Network Selected: <strong id="providerText" style="color: var(--primary-accent); font-size: 16px;"></strong>
                        </div>
                    </div>

                    <button type="submit" id="optimizeBtn" class="btn-primary w-100 mt-3" style="font-size: 18px; padding: 15px;">Optimize My Bundle</button>
                </form>

                <div id="ajaxMessages" class="mt-3"></div>
                <div id="ajaxResult" class="mt-4"></div>
            </div>
        </div>
    </div>

    <!-- AI Assistant Floating Widget -->
    <div id="aiWidgetContainer" style="position: fixed; bottom: 30px; right: 30px; z-index: 1000; filter: drop-shadow(0 15px 30px rgba(255, 42, 117, 0.2)); font-family: 'Inter', sans-serif;">
        
        <!-- Collapsed State (FAB) -->
        <button id="aiWidgetFab" title="Click to open AI Assistant" style="width: 65px; height: 65px; border-radius: 50%; background: linear-gradient(135deg, var(--primary-accent), var(--secondary-accent)); border: none; color: white; font-size: 32px; display: flex; align-items: center; justify-content: center; cursor: pointer; transition: transform 0.3s ease; box-shadow: 0 4px 15px rgba(255, 42, 117, 0.4);" onclick="toggleAiWidget()">
            ✨
        </button>

        <!-- Expanded Chat Window -->
        <div id="aiWidgetChat" class="glass-container p-0" style="display: none; width: 380px; flex-direction: column; background: var(--bg-card); box-shadow: 0 4px 30px rgba(255, 42, 117, 0.15); overflow: hidden; border: 1px solid var(--glass-border); border-radius: 20px;">
            
            <!-- Header -->
            <div style="background: linear-gradient(135deg, var(--primary-accent), var(--secondary-accent)); padding: 15px 20px; display: flex; justify-content: space-between; align-items: center; color: white;">
                <div style="display: flex; align-items: center; gap: 10px;">
                    <span style="font-size: 24px;">🤖</span>
                    <div>
                        <h2 style="margin: 0; font-size: 16px; color: white; font-weight: 600; font-family: 'Inter', sans-serif;">AI Assistant</h2>
                        <span style="font-size: 12px; opacity: 0.9;">Online and ready</span>
                    </div>
                </div>
                <button onclick="toggleAiWidget()" style="background: transparent; border: none; color: white; font-size: 24px; cursor: pointer; line-height: 1;">&times;</button>
            </div>
            
            <div style="padding: 20px; display: flex; flex-direction: column;">
                <div id="assistantChat" style="background: var(--bg-main); padding: 15px; border-radius: 12px; margin-bottom: 15px; border: 1px solid var(--glass-border); height: 300px; overflow-y: auto;">
                    <div style="text-align: left; margin-bottom: 15px;">
                        <span style="background: var(--primary-accent); color: white; padding: 10px 14px; border-radius: 12px 12px 12px 0; display: inline-block; font-size: 14px;">
                            Hi! I'm your AI Data Assistant! Ask me anything about your data usage or our bundles.
                        </span>
                    </div>
                </div>

                <form id="assistantForm" style="margin: 0;">
                    <div style="position: relative;">
                        <input type="text" id="assistantInput" name="Question" class="form-control" placeholder="Ask a question..." required style="padding: 10px 45px 10px 15px; border-radius: 20px; background-color: #ffffff; border: 1px solid var(--glass-border); color: var(--text-main); font-size: 14px;" />
                        <button type="submit" id="assistantBtn" style="position: absolute; right: 5px; top: 0; bottom: 0; border: none; background: transparent; color: var(--primary-accent); font-size: 18px; cursor: pointer; padding: 0 10px;">
                            ➤
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Flourish-Style Alternating Feature Sections -->
    <hr style="border-top: 1px solid var(--glass-border); margin: 60px 0;">

    <!-- Feature 1: The Chart -->
    <div class="row align-items-center mb-5 py-5">
        <div class="col-md-5 pe-md-5">
            <h3 style="color: var(--primary-accent); font-size: 32px; font-weight: 700; margin-bottom: 20px; letter-spacing: -0.5px;">Your data, fully interactive</h3>
            <p style="color: var(--text-main); font-size: 18px; line-height: 1.7; opacity: 0.9;">
                Visualizing your data shouldn't be a black box. This interactive chart visually plots the simulated historical footprint actively generated by our Background Workers, providing the exact dataset our Machine Learning algorithm uses to train itself. In a real-world scenario, this visualization seamlessly maps your authentic, day-to-day data consumption over time, granting you complete transparency into your digital habits.
            </p>
        </div>
        <div class="col-md-7">
            <div class="glass-container p-4" style="background: rgba(255, 255, 255, 0.05); border: 1px solid var(--glass-border); box-shadow: 0 20px 40px rgba(0,0,0,0.05);">
                <canvas id="usageChart" style="max-height: 300px; width: 100%;"></canvas>
            </div>
        </div>
    </div>

    <!-- Feature 2: Machine Learning -->
    <div class="row align-items-center mb-5 py-5">
        <div class="col-md-6 order-2 order-md-1">
            <div class="glass-container p-5 text-center d-flex align-items-center justify-content-center" style="background: linear-gradient(135deg, rgba(238, 186, 76, 0.1) 0%, rgba(255, 140, 105, 0.05) 100%); min-height: 350px; border: 1px solid var(--secondary-accent);">
                <div style="font-size: 120px; filter: drop-shadow(0 15px 25px rgba(255, 140, 105, 0.3)); animation: float 6s ease-in-out infinite;">🧠</div>
            </div>
        </div>
        <div class="col-md-6 order-1 order-md-2 ps-md-5">
            <h3 style="color: var(--primary-accent); font-size: 32px; font-weight: 700; margin-bottom: 20px; letter-spacing: -0.5px;">Hyper-Personalized Machine Learning</h3>
            <p style="color: var(--text-main); font-size: 18px; line-height: 1.7; opacity: 0.9;">
                Estimating a generic "average" for data consumption is inherently flawed. Underestimating leads to unexpected, frustrating disconnections, while overestimating results in expired data and wasted money. Our proprietary Machine Learning engine trains exclusively on your highly-specific historical consumption footprint, guaranteeing mathematical precision tailored solely to your unique digital lifestyle.
            </p>
        </div>
    </div>




</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        function toggleAiWidget() {
            const fab = document.getElementById('aiWidgetFab');
            const chat = document.getElementById('aiWidgetChat');
            if (chat.style.display === 'none') {
                chat.style.display = 'flex';
                fab.style.display = 'none';
            } else {
                chat.style.display = 'none';
                fab.style.display = 'flex';
            }
        }

        document.addEventListener("DOMContentLoaded", async function() {
            // Handle AJAX Form Submission for seamless experience
            const optimizeForm = document.getElementById('optimizeForm');
            const optimizeBtn = document.getElementById('optimizeBtn');
            const ajaxMessages = document.getElementById('ajaxMessages');
            const ajaxResult = document.getElementById('ajaxResult');
            const providerInput = document.getElementById('providerInput');
            const selectedProviderDisplay = document.getElementById('selectedProviderDisplay');
            const providerText = document.getElementById('providerText');

            if (providerInput) {
                providerInput.addEventListener('change', function() {
                    providerText.innerText = this.options[this.selectedIndex].text;
                    selectedProviderDisplay.style.display = 'flex';
                });
            }

            if (optimizeForm) {
                optimizeForm.addEventListener('submit', async function(e) {
                    e.preventDefault();
                    
                    const duration = document.getElementById('durationInput').value;
                    const timeUnit = document.getElementById('timeUnitInput').value;
                    const provider = document.getElementById('providerInput').value;
                    
                    optimizeBtn.innerText = 'Calculating...';
                    optimizeBtn.disabled = true;
                    ajaxMessages.innerHTML = '';
                    ajaxResult.innerHTML = '';

                    try {
                        const response = await fetch('/Home/OptimizeAjax', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ duration: parseInt(duration), timeUnit: timeUnit, provider: provider })
                        });
                        
                        const data = await response.json();
                        if (data.success) {
                            let bundlesHtml = '';
                            let totalCost = 0;
                            let totalProvidedMB = 0;
                            data.bundles.forEach(b => {
                                bundlesHtml += `<li style="margin-bottom: 5px;"><strong>${b.name}</strong> - ₦${b.price}</li>`;
                                totalCost += b.price;
                                totalProvidedMB += b.dataAmountMB;
                            });

                            let warningHtml = '';
                            if (data.bundles.length > 1) {
                                warningHtml = `<div style="background: rgba(238, 186, 76, 0.2); padding: 10px; border-radius: 8px; border-left: 3px solid var(--secondary-accent); margin-bottom: 15px; font-size: 14px; color: var(--text-main);">
                                    <strong>Note:</strong> Your predicted data needs (${Math.round(data.predictedTotalMB)} MB) surpassed the maximum single bundle available from your provider. We have automatically calculated the cheapest mathematical combination to fulfill your needs.
                                </div>`;
                            }

                            ajaxResult.innerHTML = `
                                <div class="result-card p-4" style="background: #fff8f5; border-radius: 16px; border-left: 5px solid var(--primary-accent); text-align: left;">
                                    <h3 style="color: var(--primary-accent); margin-top: 0;">Optimal Prediction Result</h3>
                                    ${warningHtml}
                                    <p style="color: var(--text-main); margin-bottom: 10px; font-size: 15px;">
                                        The Machine Learning model predicts you will need exactly <strong>${Math.round(data.predictedTotalMB)} MB</strong> for the selected timeframe.
                                    </p>
                                    <p style="color: var(--text-main); margin-bottom: 10px;">We recommend purchasing the following:</p>
                                    <ul style="color: var(--text-main); margin-bottom: 15px;">
                                        ${bundlesHtml}
                                    </ul>
                                    <p style="color: var(--text-main); margin-bottom: 20px;">
                                        Total Combined Cost: <strong>₦${totalCost}</strong> (Yields ${totalProvidedMB} MB)
                                    </p>
                                    <button id="scheduleBtn" class="btn btn-success w-100" style="background: #10b981; border: none; border-radius: 8px; font-weight: 600; padding: 12px;">
                                        Enable Auto-Purchase
                                    </button>
                                </div>
                            `;

                            document.getElementById('scheduleBtn').addEventListener('click', async function() {
                                this.innerText = 'Scheduling...';
                                this.disabled = true;
                                const schedRes = await fetch('/Home/SchedulePurchaseAjax', {
                                    method: 'POST',
                                    headers: { 'Content-Type': 'application/json' },
                                    body: JSON.stringify({ predictedMB: totalProvidedMB, provider: data.provider, duration: data.duration, timeUnit: data.timeUnit })
                                });
                                const schedData = await schedRes.json();
                                if (schedData.success) {
                                    ajaxMessages.innerHTML = `<div class="alert alert-success" style="border-radius: 12px; background: rgba(16, 185, 129, 0.2); border: 1px solid #10b981; color: #10b981;">${schedData.message}</div>`;
                                }
                                this.innerText = 'Auto-Purchase Enabled';
                            });
                        } else {
                            ajaxResult.innerHTML = `
                                <div class="result-card p-4" style="background: #fff8f5; border-radius: 16px; border-left: 5px solid var(--primary-accent); text-align: left;">
                                    <h3 style="color: var(--primary-accent); margin-top: 0;">Wait!</h3>
                                    <p style="color: var(--text-main); margin-bottom: 0;">${data.error}</p>
                                </div>
                            `;
                        }
                    } catch (err) {
                        console.error(err);
                    } finally {
                        optimizeBtn.innerText = 'Optimize My Bundle';
                        optimizeBtn.disabled = false;
                    }
                });
            }

            // Handle Assistant Chat Submission via AJAX
            const assistantForm = document.getElementById('assistantForm');
            const assistantInput = document.getElementById('assistantInput');
            const assistantBtn = document.getElementById('assistantBtn');
            const assistantChat = document.getElementById('assistantChat');

            if (assistantForm) {
                assistantForm.addEventListener('submit', async function(e) {
                    e.preventDefault();
                    const question = assistantInput.value;
                    if (!question) return;

                    assistantBtn.disabled = true;
                    assistantInput.disabled = true;

                    assistantChat.innerHTML += `
                        <div style="margin-bottom: 15px; text-align: right;">
                            <span style="background: #ffffff; border: 1px solid #eaddd7; color: var(--text-main); padding: 8px 15px; border-radius: 15px 15px 0 15px; display: inline-block; font-size: 14px;">
                                ${question}
                            </span>
                        </div>
                        <div id="loadingBubble" style="text-align: left; margin-bottom: 15px;">
                            <span style="background: var(--primary-accent); color: white; padding: 12px 18px; border-radius: 15px 15px 15px 0; display: inline-block; font-size: 15px; opacity: 0.7;">
                                Thinking...
                            </span>
                        </div>
                    `;
                    assistantChat.scrollTop = assistantChat.scrollHeight;
                    
                    try {
                        const response = await fetch('/Assistant/AskAjax', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ question: question })
                        });
                        
                        const data = await response.json();
                        const loader = document.getElementById('loadingBubble');
                        if (loader) loader.remove();

                        if (data.success) {
                            assistantChat.innerHTML += `
                                <div style="text-align: left; margin-bottom: 15px;">
                                    <span style="background: var(--primary-accent); color: white; padding: 12px 18px; border-radius: 15px 15px 15px 0; display: inline-block; font-size: 15px; line-height: 1.5;">
                                        ${data.answer}
                                    </span>
                                </div>
                            `;
                        } else {
                            assistantChat.innerHTML += `
                                <div style="text-align: left; margin-bottom: 15px;">
                                    <span style="background: rgba(220, 38, 38, 0.8); color: white; padding: 12px 18px; border-radius: 15px 15px 15px 0; display: inline-block; font-size: 15px;">
                                        ${data.error}
                                    </span>
                                </div>
                            `;
                        }
                    } catch (err) {
                        console.error(err);
                    } finally {
                        assistantBtn.disabled = false;
                        assistantInput.disabled = false;
                        assistantInput.value = '';
                        assistantChat.scrollTop = assistantChat.scrollHeight;
                    }
                });
            }

            try {
                const response = await fetch('/Home/GetUsageData');
                const data = await response.json();
                
                const labels = data.map(d => d.date);
                const values = data.map(d => d.mb);

                const ctx = document.getElementById('usageChart').getContext('2d');
                new Chart(ctx, {
                    type: 'line',
                    data: {
                        labels: labels,
                        datasets: [{
                            label: 'Data Consumed (MB)',
                            data: values,
                            borderColor: '#ff8c69', /* Lively Peach */
                            backgroundColor: 'rgba(255, 140, 105, 0.15)', /* Transparent Peach */
                            borderWidth: 2,
                            tension: 0.4,
                            fill: true,
                            pointBackgroundColor: '#eeba4c' /* Champagne Gold */
                        }]
                    },
                    options: {
                        responsive: true,
                        plugins: {
                            legend: { display: false }
                        },
                        scales: {
                            y: {
                                beginAtZero: true,
                                grid: { color: 'rgba(255, 255, 255, 0.05)' },
                                ticks: { color: '#94a3b8' }
                            },
                            x: {
                                grid: { color: 'rgba(255, 255, 255, 0.05)' },
                                ticks: { color: '#94a3b8' }
                            }
                        }
                    }
                });
            } catch (err) {
                console.error("Failed to load chart data:", err);
            }
        });
    </script>
}
