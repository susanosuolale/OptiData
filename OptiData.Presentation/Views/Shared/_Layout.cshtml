<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - OptiData</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/OptiData.Presentation.styles.css" asp-append-version="true" />
</head>
<body>
    <!-- DEMO MODE BANNER -->
    <div style="background: linear-gradient(90deg, #1e293b, #334155); color: #f8fafc; text-align: center; padding: 12px; font-weight: 600; font-size: 14px; position: sticky; top: 0; z-index: 9999; box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2); letter-spacing: 0.5px;">
        ⚙️ Demo Mode: You are viewing this application as Test User (John Doe Recruiter). All telecom APIs and data usage are safely simulated.
    </div>
    
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">OptiData</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - OptiData.Presentation - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    
    <!-- SIGNALR REAL-TIME WEBSOCKETS -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>
    
    <!-- Toast Notification Container -->
    <div class="position-fixed bottom-0 end-0 p-3" style="z-index: 11; transform: translateY(-20px);">
        <div id="liveToast" class="toast align-items-center text-white border-0" role="alert" aria-live="assertive" aria-atomic="true" style="background: linear-gradient(45deg, #10b981, #059669); box-shadow: 0 10px 25px rgba(16, 185, 129, 0.4); border-radius: 12px; display: none;">
            <div class="d-flex">
                <div class="toast-body" id="toastMessage" style="font-weight: 500; font-size: 15px; padding: 15px 20px;">
                    <!-- Message injected via SignalR -->
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close" onclick="document.getElementById('liveToast').style.display='none';"></button>
            </div>
        </div>
    </div>

    <script>
        // 1. Connect directly to the C# SignalR NotificationHub configuration
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/notificationHub")
            .build();

        // 2. Listen for the specific "ReceivePurchaseNotification" event sent by Hangfire
        connection.on("ReceivePurchaseNotification", function (message) {
            document.getElementById("toastMessage").innerText = message;
            
            // Show the Toast
            var toastEl = document.getElementById('liveToast');
            toastEl.style.display = 'block';
            
            // Hide it automatically after 8 seconds
            setTimeout(function () {
                toastEl.style.display = 'none';
            }, 8000);
        });

        // 3. Start the continuous WebSocket connection
        // browser sends network request to c# server
        connection.start().catch(function (err) {
            return console.error(err.toString());
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
